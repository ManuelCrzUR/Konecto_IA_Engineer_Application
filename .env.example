# Copy to .env and fill in. Never commit .env.
# Host port for Postgres (change if 5432 is busy; the URLs below follow it)
DB_PORT=5432
# Host port for the API (change if 8000 is busy, e.g. API_PORT=8001)
API_PORT=8000
# Interfaces the ports bind to. Localhost by default; the Android app reaches the API
# through `adb reverse` (make android-reverse), emulator or USB phone. API_BIND=0.0.0.0
# is only needed for a phone over Wi-Fi (then set api.baseUrl to the Mac's LAN IP).
API_BIND=127.0.0.1
DB_BIND=127.0.0.1
# Application database
DATABASE_URL=postgresql://series76:series76@localhost:${DB_PORT}/series76
# Database used by pytest (created by `make db` / `make test`; also by docker/initdb on a fresh volume)
TEST_DATABASE_URL=postgresql://series76:series76@localhost:${DB_PORT}/series76_test

# OpenAI-compatible LLM endpoint (OpenRouter by default;
# dev alternative: Google AI Studio https://generativelanguage.googleapis.com/v1beta/openai/)
LLM_BASE_URL=https://openrouter.ai/api/v1
# API key for the endpoint above
LLM_API_KEY=
# Model used by the chat agent (benchmarked default; free alternative: stealth/crouton-alpha, temporary; budget is a hard USD 10 limit)
AGENT_MODEL=openai/gpt-6-luna
# Vision model for PDF extraction escalation (only used when OCR flags a table), e.g. anthropic/claude-sonnet-5.5
EXTRACT_LLM_MODEL=anthropic/claude-sonnet-5.5
# Spend caps (optional; defaults shown). Max output tokens per chat call, per task.
# AGENT_MAX_TOKENS=1024
# EXTRACT_MAX_TOKENS=4096
# Max paid vision calls per extraction run (7 tables = 7 calls at most).
# VISION_MAX_CALLS=7
# auto (default) = escalate to the vision model only if LLM_API_KEY and EXTRACT_LLM_MODEL are set; on / off force it.
# It is only called when the data must be rebuilt from the PDF, never on a normal startup.
STARTUP_ESCALATION=auto

# Login (D-43): create the three documented test users at startup (on by default; off for a real deployment).
SEED_TEST_USERS=on
