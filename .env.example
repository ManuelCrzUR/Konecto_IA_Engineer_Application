# Copy to .env and fill in. Never commit .env.
# Host port for Postgres (change if 5432 is busy; update the URLs below to match)
DB_PORT=5432
# Host port for the API (change if 8000 is busy, e.g. API_PORT=8001)
API_PORT=8000
# Interfaces the ports bind to. Localhost by default; the Android emulator reaches
# it as 10.0.2.2. Set API_BIND=0.0.0.0 to test from a physical phone on your LAN.
API_BIND=127.0.0.1
DB_BIND=127.0.0.1
# Application database
DATABASE_URL=postgresql://series76:series76@localhost:5432/series76
# Database used by pytest (created automatically by docker/initdb)
TEST_DATABASE_URL=postgresql://series76:series76@localhost:5432/series76_test

# OpenAI-compatible LLM endpoint (OpenRouter by default;
# dev alternative: Google AI Studio https://generativelanguage.googleapis.com/v1beta/openai/)
LLM_BASE_URL=https://openrouter.ai/api/v1
# API key for the endpoint above
LLM_API_KEY=
# Model used by the chat agent
AGENT_MODEL=
# Model used for PDF extraction (vision)
EXTRACT_LLM_MODEL=
# on = the API may call the (paid) vision model at startup if the data must be
# re-extracted from the PDF. Off by default: the API never spends on its own.
STARTUP_ESCALATION=off
